{
  "name": "lynko-chat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.9.0" },
  "scripts": {
    "build:client": "esbuild app.tsx --bundle --minify --platform=browser --format=iife --target=es2020 --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\" --outfile=public/app.js",
    "build": "npm run build:client",
    "dev": "npm run build:client && tsx watch --env-file=.env.local index.ts",
    "start": "tsx --env-file=.env.local index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@node-rs/argon2": "^2.0.0",
    "@vercel/functions": ">=2.0.0",
    "hono": "^4.6.0",
    "mongodb": "^6.10.0",
    "pusher": "^5.2.0",
    "pusher-js": "^8.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
